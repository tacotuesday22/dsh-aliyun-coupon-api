{
  "name": "dsh-aliyun-coupon-api",
  "version": "1.6.1",
  "description": "阿里云余额与代金券挂件（DeepSeek Harness 插件）：通过阿里云官方 OpenAPI 只读查询账户余额（QueryAccountBalance）与「云工开物」学生券剩余额度（DescribeCoupon），在侧边栏底部显示。无需账号密码，只需 RAM 只读 AccessKey。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "aliyun",
    "coupon",
    "bss",
    "DescribeCoupon",
    "QueryAccountBalance",
    "balance",
    "云工开物"
  ],
  "license": "MIT",
  "author": "tacotuesday22",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tacotuesday22/dsh-aliyun-coupon-api.git"
  },
  "bugs": {
    "url": "https://github.com/tacotuesday22/dsh-aliyun-coupon-api/issues"
  },
  "homepage": "https://github.com/tacotuesday22/dsh-aliyun-coupon-api#readme",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node build.mjs",
    "prepare": "node build.mjs",
    "test": "node test-logic.mjs && node test-usage.mjs && node test-inject.mjs && node test-client.mjs && node test-real.mjs",
    "prepublishOnly": "node build.mjs"
  },
  "files": [
    "lib",
    "src",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "os": [
    "darwin",
    "linux",
    "win32"
  ],
  "engines": {
    "node": ">=20.0.0",
    "dsh": ">=0.1.6"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  }
}